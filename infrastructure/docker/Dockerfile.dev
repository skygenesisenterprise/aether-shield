# Dockerfile.dev - Development environment for Aether Shield
#
# This Dockerfile is optimized for local development with:
# - Hot reloading for both Go server and Next.js app
# - Debugging capabilities
# - Development dependencies
# - Mounted volumes for code changes
# - Single public port exposure (3000)
#

# Stage 1: Build the Next.js app using the dedicated app/Dockerfile.dev
FROM node:18-alpine AS nextjs-dev

# Install build dependencies
RUN apk add --no-cache libc6-compat git

# Set working directory
WORKDIR /app

# Install pnpm globally
RUN npm install -g pnpm

# Copy package files
COPY app/package.json app/pnpm-lock.yaml ./app/

# Install all dependencies (including dev dependencies)
RUN cd /app && pnpm install

# Copy source code
COPY app/. /app/

# Create non-root user first
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Switch to non-root user before creating directories
USER nextjs

# Create necessary directories as the non-root user
RUN mkdir -p /app/.next/cache /app/public

# Set environment variables for development
ENV NODE_ENV=development
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Expose port
EXPOSE 3000

# Stage 2: Build the Go server
FROM golang:1.21-alpine AS go-dev

# Install common dependencies for development
RUN apk add --no-cache \
    git \
    python3 \
    py3-pip \
    make \
    g++ \
    bash \
    curl \
    wget \
    openssl \
    tzdata \
    postgresql-dev \
    gcc \
    musl-dev \
    libpq \
    && rm -rf /var/cache/apk/*

# Set working directory
WORKDIR /app

# Copy the server code
COPY server/ /app/server/

# Install Go dependencies
RUN cd /app/server && go mod tidy

# Stage 3: Final development environment
FROM node:20-alpine AS developer

# Install common dependencies for development
RUN apk add --no-cache \
    git \
    python3 \
    py3-pip \
    make \
    g++ \
    bash \
    curl \
    wget \
    openssl \
    tzdata \
    postgresql-dev \
    gcc \
    musl-dev \
    libpq \
    && rm -rf /var/cache/apk/*

# Install Go for the server
RUN curl -L https://golang.org/dl/go1.21.0.linux-amd64.tar.gz | tar -xz -C /usr/local
ENV PATH=/usr/local/go/bin:$PATH
ENV GOPATH=/go
ENV GO111MODULE=on

# Install pnpm globally
RUN npm install -g pnpm

# Set working directory
WORKDIR /app

# Copy from Next.js stage
COPY --from=nextjs-dev /app /app

# Copy from Go stage
COPY --from=go-dev /app/server /app/server

# Copy Prisma directory specifically for generation
COPY prisma/ prisma/

# Install Prisma CLI globally
RUN npm install -g prisma

# Initialize Prisma client (only for prisma package)
RUN cd /app/prisma && cp .env.example .env && npx prisma generate

# Expose only the public port
EXPOSE 3000

# Health check for development
HEALTHCHECK --interval=30s --timeout=3s \
    CMD curl -f http://localhost:3000 || exit 1

# Copy the start script
COPY infrastructure/docker/start-dev.sh /app/start-dev.sh
RUN chmod +x /app/start-dev.sh

# Development entrypoint
CMD ["sh", "/app/start-dev.sh"]