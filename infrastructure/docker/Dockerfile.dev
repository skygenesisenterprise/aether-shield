# Dockerfile.dev - Multi-stage development environment
# This Dockerfile combines app, server, and prisma development stages

# ============================================
# Stage 1: Base setup with common dependencies
# ============================================
FROM node:20-alpine as base

# Install system dependencies
RUN apk add --no-cache \
    libc6-compat \
    git \
    bash \
    curl \
    build-base \
    go \
    && rm -rf /var/cache/apk/*

# Enable Corepack and pnpm
RUN corepack enable && corepack prepare pnpm@10.28.1 --activate

# ============================================
# Stage 2: App development (Next.js)
# ============================================
FROM base as app-dev

WORKDIR /app

# Expose dev ports
EXPOSE 3000 24678

# Environment variables
ENV NODE_ENV=development \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    CHOKIDAR_USEPOLLING=true

# Copy package files and install dependencies
COPY ../../app/package.json ../../app/pnpm-lock.yaml ./

# Install dependencies
RUN pnpm install --force

# Copy app source
COPY ../../app .

# ============================================
# Stage 3: Server development (Go)
# ============================================
FROM base as server-dev

WORKDIR /server

# Expose dev ports
EXPOSE 8080 24678

# Environment variables
ENV GOENV=development \
    PORT=8080 \
    HOSTNAME=0.0.0.0

# Copy go.mod and go.sum
COPY ../../server/go.mod ../../server/go.sum ./

# Download Go dependencies
RUN go mod download

# Copy server source
COPY ../../server .

# ============================================
# Stage 4: Prisma development
# ============================================
FROM base as prisma-dev

WORKDIR /prisma

# Expose dev ports
EXPOSE 5555

# Environment variables
ENV NODE_ENV=development \
    PORT=5555 \
    HOSTNAME=0.0.0.0

# Copy package files and install dependencies
COPY ../../prisma/package.json ../../prisma/pnpm-lock.yaml ./

# Install dependencies
RUN pnpm install --force

# Copy prisma source
COPY ../../prisma .

# ============================================
# Final stage: Combined development environment
# ============================================
FROM base as dev-environment

# Create directory structure
RUN mkdir -p /app /server /prisma

# Copy built assets from each stage
COPY --from=app-dev /app /app
COPY --from=server-dev /server /server
COPY --from=prisma-dev /prisma /prisma

# Install additional tools for development
RUN apk add --no-cache \
    docker-cli \
    docker-compose \
    && rm -rf /var/cache/apk/*

# Set working directory
WORKDIR /workspace

# Environment variables for the combined environment
ENV NODE_ENV=development \
    APP_PORT=3000 \
    SERVER_PORT=8080 \
    PRISMA_PORT=5555 \
    HOSTNAME=0.0.0.0

# Health check for development services
HEALTHCHECK --interval=30s --timeout=3s \
    CMD curl -f http://localhost:3000 || exit 1

# Default command - can be overridden
CMD ["sh", "-c", "echo 'Development environment ready. Use docker-compose to start individual services.'"]
